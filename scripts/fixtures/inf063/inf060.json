        "name": "telemetry",
        "namespace": "mti-m5-desc-inf060-r423",
        "labels": {
          "m5-session": "mti-m5-desc-inf060-r423"
        }
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "telemetry"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "telemetry",
              "m5-session": "mti-m5-desc-inf060-r423"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "terminationGracePeriodSeconds": 45,
            "nodeSelector": {
              "m5-role": "cpu"
            },
            "containers": [
              {
                "name": "prometheus",
                "image": "prom/prometheus:v3.13.0@sha256:c6b27ea434f8389bfe233fbc7be381cf50587c286e871bc842008f5a1b1908a7",
                "args": [
                  "--config.file=/etc/prometheus/prometheus.yml",
                  "--storage.tsdb.path=/data",
                  "--storage.tsdb.retention.time=4h",
                  "--storage.tsdb.retention.size=512MB"
                ],
                "ports": [
                  {
                    "containerPort": 9090
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "config",
                    "mountPath": "/etc/prometheus",
                    "readOnly": true
                  },
                  {
                    "name": "data",
                    "mountPath": "/data"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "512Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                }
              }
            ],
            "securityContext": {
              "runAsUser": 65534,
              "runAsNonRoot": true,
              "fsGroup": 65534
            },
            "volumes": [
              {
                "name": "config",
                "configMap": {
                  "name": "telemetry"
                }
              },
              {
                "name": "data",
                "emptyDir": {
                  "sizeLimit": "1Gi"
                }
              }
            ]
          }
        },
        "strategy": {
          "type": "Recreate"
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "DaemonSet",
      "metadata": {
        "name": "nvidia-device-plugin",
        "namespace": "mti-m5-desc-inf060-r423",
        "labels": {
          "m5-session": "mti-m5-desc-inf060-r423"
        }
      },
      "spec": {
        "selector": {
          "matchLabels": {
            "app": "nvidia-device-plugin"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "nvidia-device-plugin"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "nodeSelector": {
              "m5-role": "gpu"
            },
            "tolerations": [
              {
                "key": "nvidia.com/gpu",
                "operator": "Exists",
                "effect": "NoSchedule"
              }
            ],
            "containers": [
              {
                "name": "plugin",
                "image": "nvcr.io/nvidia/k8s-device-plugin:v0.17.1@sha256:af31e2b7c7f89834c4e5219860def7ac2e49a207b3d4e8610d5a26772b7738e5",
                "env": [
                  {
                    "name": "FAIL_ON_INIT_ERROR",
                    "value": "true"
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "plugins",
                    "mountPath": "/var/lib/kubelet/device-plugins"
                  }
                ],
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                }
              }
            ],
            "volumes": [
              {
                "name": "plugins",
                "hostPath": {
                  "path": "/var/lib/kubelet/device-plugins",
                  "type": "Directory"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "inf060-clock",
        "namespace": "mti-m5-desc-inf060-r423"
      },
      "immutable": true,
      "data": {
        "config.json": "{\n  \"formatters\": {\n    \"vllm\": {\n      \"class\": \"vllm.logging_utils.NewLineFormatter\",\n      \"format\": \"%(created).6f %(levelname)s [%(fileinfo)s:%(lineno)d] %(message)s\"\n    },\n    \"vllm_color\": {\n      \"class\": \"vllm.logging_utils.ColoredFormatter\",\n      \"format\": \"%(created).6f %(levelname)s [%(fileinfo)s:%(lineno)d] %(message)s\"\n    }\n  },\n  \"handlers\": {\n    \"vllm\": {\n      \"class\": \"logging.StreamHandler\",\n      \"formatter\": \"vllm\",\n      \"level\": \"INFO\",\n      \"stream\": \"ext://sys.stdout\"\n    }\n  },\n  \"loggers\": {\n    \"vllm\": {\n      \"handlers\": [\n        \"vllm\"\n      ],\n      \"level\": \"INFO\",\n      \"propagate\": false\n    }\n  },\n  \"version\": 1,\n  \"disable_existing_loggers\": false\n}\n"
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "inf060-clock",
        "namespace": "mti-m5-desc-inf060-r423"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app": "vllm"
          }
        },
        "policyTypes": [
          "Ingress"
        ],
        "ingress": [
          {
            "ports": [
              {
                "protocol": "TCP",
                "port": 8000
              }
            ]
          },
          {
            "ports": [
              {
                "protocol": "TCP",
                "port": 8765
              }
            ],
            "from": [
              {
                "podSelector": {
                  "matchLabels": {
                    "app": "load-client",
                    "inf060-role": "streaming-client"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}

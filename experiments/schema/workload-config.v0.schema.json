{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/multi-tenant-inference/workload-config.v0.schema.json",
  "title": "Workload configuration v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "arrival_rate_rps",
    "max_tokens",
    "model",
    "prefixes",
    "request_count",
    "run_id",
    "schema_version",
    "seed",
    "tenant_ids"
  ],
  "properties": {
    "arrival_rate_rps": {"type": "number", "exclusiveMinimum": 0},
    "max_tokens": {"type": "integer", "minimum": 1},
    "model": {"$ref": "#/$defs/model"},
    "prefixes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "request_count": {"type": "integer", "minimum": 1},
    "run_id": {"$ref": "#/$defs/runIdentifier"},
    "schema_version": {"const": "workload-config.v0"},
    "seed": {"type": "integer"},
    "tenant_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,190}$"
    },
    "model": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$"
    },
    "runIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,183}$"
    }
  }
}

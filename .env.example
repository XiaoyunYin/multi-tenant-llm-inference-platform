# Local-only development defaults. Do not put credentials in this file.
GATEWAY_HTTP_ADDR=:8080
GATEWAY_ROUTING_POLICY=round_robin
REDIS_ADDR=localhost:6379
ADMISSION_MODE=redis
ADMISSION_NAMESPACE=mti:local:v1
ADMISSION_GLOBAL_CAPACITY=64
ADMISSION_LEASE=3m
ADMISSION_TOMBSTONE_TTL=5m
GATEWAY_ADMISSION_TIMEOUT=250ms
GATEWAY_RELEASE_TIMEOUT=1s
GATEWAY_TOTAL_TIMEOUT=2m
GATEWAY_FIRST_ITEM_TIMEOUT=5s
GATEWAY_MAX_CONCURRENT=64
BACKENDS=fake-backend-a=http://localhost:8001,fake-backend-b=http://localhost:8002
BACKEND_METRICS_INTERVAL=500ms
BACKEND_METRICS_MAX_AGE=1s
TENANT_CONFIG_PATH=deploy/local/tenants.json
CACHE_SALT_SECRET_FILE=deploy/local/cache-salt.secret
GATEWAY_SHUTDOWN_GRACE=2m
GATEWAY_SHUTDOWN_HARD_STOP=10s
LOG_LEVEL=info
# Tracing is disabled until an endpoint is explicit. For local OTLP/HTTP:
# OTEL_TRACES_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
